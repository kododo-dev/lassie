# Copy to .env in /opt/docker/lassie on the VPS (next to docker-compose.yml). Never commit the real .env.

# GitHub Container Registry owner (org or username that owns the lassie image)
GHCR_OWNER=your-github-username

# Set/updated by the deploy workflow on each release; pin to a previous SHA to roll back
LASSIE_IMAGE_TAG=latest

# The VPS already runs a shared Postgres container (the `kododo` stack) — Lassie gets
# its own database inside that instance rather than its own Postgres container.
POSTGRES_DB=lassie
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Only matter for the very first boot — the app seeds exactly one admin account
# when the Users table is empty, then never touches these again. Rotating them
# here later has no effect without a manual database change.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-first-deploy
