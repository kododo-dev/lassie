<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lassie</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The verification-audit pipeline exposes DrainOnceAsync / SweepAsync as `internal`
         so the writer- and retention-seam tests can drive one batch/sweep directly
         (see context/changes/license-verification-audit-log/plan.md). -->
    <InternalsVisibleTo Include="Lassie.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lassie.Tests is a nested project directory under this one; without these, the
         SDK's implicit **/*.cs (and content) globs would also pull the test project's
         files into this project's own compilation. -->
    <Compile Remove="Lassie.Tests/**" />
    <Content Remove="Lassie.Tests/**" />
    <EmbeddedResource Remove="Lassie.Tests/**" />
    <None Remove="Lassie.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
