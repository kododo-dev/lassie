@page "/"
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer
@using Lassie.Components.Shared
@using Lassie.Data
@using Lassie.Data.Licenses
@using Microsoft.EntityFrameworkCore
@inject LassieDbContext DbContext

<PageTitle>Lassie</PageTitle>

<h1>Lassie admin panel</h1>

@if (licenses.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">No licenses yet.</MudAlert>
    <MudButton Href="licenses/new" Variant="Variant.Filled" Color="Color.Primary">Create a license</MudButton>
}
else
{
    <MudTable Items="licenses" Hover="true">
        <HeaderContent>
            <MudTh>Label</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Expires</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Label">@context.Label</MudTd>
            <MudTd DataLabel="Status"><LicenseStatusBadge Status="context.Status" /></MudTd>
            <MudTd DataLabel="Expires">@(context.ExpiresOn is not null ? context.ExpiresOn.Value.ToString("yyyy-MM-dd") : "No expiry")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Href="@($"licenses/{context.Id}/edit")" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<License> licenses = new();

    protected override async Task OnInitializedAsync()
    {
        licenses = await DbContext.Licenses.AsNoTracking().OrderBy(l => l.Label).ToListAsync();
    }
}
