@page "/"
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer
@using Lassie.Components.Shared
@using Lassie.Data
@using Lassie.Data.Licenses
@using Microsoft.EntityFrameworkCore
@inject LassieDbContext DbContext

<PageTitle>Lassie</PageTitle>

<MudProviders />

<h1>Lassie admin panel</h1>

<div class="d-flex flex-wrap justify-end mb-4">
    <MudButton Href="licenses/new" Variant="Variant.Filled" Color="Color.Primary">New License</MudButton>
</div>

@if (licenses.Count == 0)
{
    <MudAlert Severity="Severity.Info">No licenses yet.</MudAlert>
}
else
{
    <div style="overflow-x: auto;">
        <MudDataGrid @ref="_dataGrid" T="License" Items="licenses" Hover="true" Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterRow">
            <Columns>
                <PropertyColumn Property="x => x.Label" Title="Label" />
                <PropertyColumn T="License" TProperty="LicenseStatus" Property="x => x.Status" Title="Status" SortBy="SortStatusBy">
                    <CellTemplate>
                        <LicenseStatusBadge Status="context.Item.Status" />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn T="License" TProperty="DateOnly?" Property="x => x.ExpiresOn" Title="Expires" SortBy="SortExpiresBy">
                    <CellTemplate>
                        @(context.Item.ExpiresOn is not null ? context.Item.ExpiresOn.Value.ToString("yyyy-MM-dd") : "No expiry")
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Href="@($"licenses/{context.Item.Id}/edit")" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </div>
}

@code {
    private MudDataGrid<License> _dataGrid = null!;
    private List<License> licenses = new();

    protected override async Task OnInitializedAsync()
    {
        licenses = await DbContext.Licenses.AsNoTracking().OrderBy(l => l.Label).ToListAsync();
    }

    // Priority order (not alphabetical/enum declaration order) — an admin sorting by
    // status wants active licenses grouped first, not "Active, Deactivated, Expired".
    private static object SortStatusBy(License license) => license.Status switch
    {
        LicenseStatus.Active => 0,
        LicenseStatus.Expired => 1,
        LicenseStatus.Deactivated => 2,
        _ => 3
    };

    // MudDataGrid sorts ascending/descending via LINQ OrderBy/OrderByDescending, which
    // flips comparer polarity per direction — a static "null = extreme" sentinel would
    // put no-expiry licenses first on one direction and last on the other. Reading the
    // column's *current* direction here and flipping the sentinel to match cancels that
    // out, keeping no-expiry licenses last in both directions.
    private object SortExpiresBy(License license)
    {
        var descending = _dataGrid?.SortDefinitions.TryGetValue(nameof(License.ExpiresOn), out var def) == true && def.Descending;
        if (license.ExpiresOn is null)
        {
            return descending ? DateTime.MinValue : DateTime.MaxValue;
        }
        return license.ExpiresOn.Value.ToDateTime(TimeOnly.MinValue);
    }
}
