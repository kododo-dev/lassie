@page "/licenses/new"
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Lassie.Components.Shared
@using Lassie.Data
@using Lassie.Data.Licenses
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@inject LassieDbContext DbContext
@inject IJSRuntime JS

<PageTitle>New License — Lassie</PageTitle>

<MudProviders />

<h1>New License</h1>

@if (createdLabel is null)
{
    <EditForm Model="Model" FormName="create-license" OnValidSubmit="HandleCreateAsync">
        <DataAnnotationsValidator />
        @if (errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }
        <MudTextField @bind-Value="Model.Label" Label="Label" Class="mb-4" />
        <MudDatePicker @bind-Date="ExpiresOnDateTime" Label="Expires on (optional)" Class="mb-4" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Create License</MudButton>
    </EditForm>
}
else
{
    <MudText Class="mb-2">License <strong>@createdLabel</strong> created@(createdExpiresOn is not null ? $" — expires on {createdExpiresOn:yyyy-MM-dd}" : "").</MudText>
    <MudText Class="mb-4">This is the only time the API key is shown. Copy it now — it cannot be retrieved again.</MudText>
    <MudPaper Class="pa-4 mb-4 d-flex align-center" Outlined="true">
        <code>@(keyRevealed ? createdRawKey : Mask(createdRawKey!))</code>
        <MudIconButton Class="ml-2"
                       Icon="@(keyRevealed ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                       OnClick="@(() => keyRevealed = !keyRevealed)" />
        <MudIconButton Class="ml-1" Icon="@Icons.Material.Filled.ContentCopy" OnClick="CopyKeyAsync" />
    </MudPaper>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetForm">Create another license</MudButton>
}

@code {
    [SupplyParameterFromForm]
    private CreateLicenseFormModel Model { get; set; } = new();

    private string? errorMessage;
    private string? createdLabel;
    private DateOnly? createdExpiresOn;
    private string? createdRawKey;
    private bool keyRevealed;

    // MudDatePicker binds DateTime?, not DateOnly? (no native DateOnly support as of
    // MudBlazor 9.x) — bridge through this wrapper rather than changing the form model.
    private DateTime? ExpiresOnDateTime
    {
        get => Model.ExpiresOn?.ToDateTime(TimeOnly.MinValue);
        set => Model.ExpiresOn = value is null ? null : DateOnly.FromDateTime(value.Value);
    }

    private async Task HandleCreateAsync()
    {
        var (rawKey, hash) = ApiKeyHasher.Generate();
        var license = new License
        {
            Label = Model.Label,
            ExpiresOn = Model.ExpiresOn,
            ApiKeyHash = hash
        };

        DbContext.Licenses.Add(license);

        try
        {
            await DbContext.SaveChangesAsync();
        }
        catch (DbUpdateException ex) when (ex.InnerException is Npgsql.PostgresException { SqlState: "23505" } pgEx)
        {
            DbContext.Entry(license).State = EntityState.Detached;
            errorMessage = pgEx.ConstraintName == "IX_Licenses_Label"
                ? "This label already exists."
                : "Something went wrong while saving. Please try again.";
            return;
        }

        // Detach so repeated creations in one Blazor Server circuit (long-lived DbContext,
        // not per-request) don't grow the change tracker unbounded.
        DbContext.Entry(license).State = EntityState.Detached;

        createdLabel = license.Label;
        createdExpiresOn = license.ExpiresOn;
        createdRawKey = rawKey;
    }

    private async Task CopyKeyAsync()
    {
        if (createdRawKey is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", createdRawKey);
        }
    }

    private void ResetForm()
    {
        errorMessage = null;
        createdLabel = null;
        createdExpiresOn = null;
        createdRawKey = null;
        keyRevealed = false;
        Model = new();
    }

    private static string Mask(string key) => new string('•', key.Length);

    private sealed class CreateLicenseFormModel
    {
        [Required]
        public string Label { get; set; } = "";

        public DateOnly? ExpiresOn { get; set; }
    }
}
