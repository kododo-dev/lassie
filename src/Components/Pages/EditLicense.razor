@page "/licenses/{Id:long}/edit"
@attribute [Authorize]
@layout MainLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Lassie.Data
@using Lassie.Data.Licenses
@using Microsoft.EntityFrameworkCore
@inject LassieDbContext DbContext

<PageTitle>Edit License — Lassie</PageTitle>

<h1>Edit License</h1>

@if (license is null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">License not found.</MudAlert>
    <MudButton Href="/" Variant="Variant.Text">Back</MudButton>
}
else
{
    <EditForm Model="Model" FormName="edit-license" OnValidSubmit="HandleSaveAsync">
        <DataAnnotationsValidator />
        @if (errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }
        @if (successMessage is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">@successMessage</MudAlert>
        }
        <MudTextField @bind-Value="Model.Label" Label="Label" Class="mb-4" />
        <MudDatePicker @bind-Date="ExpiresOnDateTime" Label="Expires on (optional)" Class="mb-4" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
        <MudButton Href="/" Variant="Variant.Text">Cancel</MudButton>
    </EditForm>
}

@code {
    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromForm]
    private EditLicenseFormModel Model { get; set; } = new();

    // Loaded via a query (not attach-and-mark-modified) and kept as the same tracked
    // instance through to SaveChangesAsync, so EF's OriginalValues — which the generic
    // audit mechanism in LassieDbContext reads — reflects the true pre-edit row. See
    // context/foundation/lessons.md ("Audit snapshots require load-before-mutate").
    private License? license;

    private string? errorMessage;
    private string? successMessage;

    // MudDatePicker binds DateTime?, not DateOnly? (no native DateOnly support as of
    // MudBlazor 9.x) — bridge through this wrapper rather than changing the form model.
    private DateTime? ExpiresOnDateTime
    {
        get => Model.ExpiresOn?.ToDateTime(TimeOnly.MinValue);
        set => Model.ExpiresOn = value is null ? null : DateOnly.FromDateTime(value.Value);
    }

    // OnParametersSetAsync (not OnInitializedAsync): Blazor reuses this component instance
    // across navigations between two /licenses/{Id}/edit URLs, so a load that only ran once
    // in OnInitializedAsync would keep editing the license for the previous Id. Guarding on
    // license.Id == Id keeps this a no-op on unrelated parameter-set re-runs.
    protected override async Task OnParametersSetAsync()
    {
        if (license is not null && license.Id == Id)
        {
            return;
        }

        if (license is not null)
        {
            // Detach the previously-loaded license (switching Id within the same circuit)
            // so the long-lived per-circuit DbContext doesn't accumulate tracked entities.
            DbContext.Entry(license).State = EntityState.Detached;
        }

        license = await DbContext.Licenses.SingleOrDefaultAsync(l => l.Id == Id);
        errorMessage = null;
        successMessage = null;
        if (license is not null)
        {
            Model = new EditLicenseFormModel
            {
                Label = license.Label,
                ExpiresOn = license.ExpiresOn
            };
        }
    }

    private async Task HandleSaveAsync()
    {
        if (license is null)
        {
            return;
        }

        license.Label = Model.Label;
        license.ExpiresOn = Model.ExpiresOn;

        try
        {
            await DbContext.SaveChangesAsync();
        }
        catch (DbUpdateException ex) when (ex.InnerException is Npgsql.PostgresException { SqlState: "23505" } pgEx)
        {
            // No reload/detach here (unlike CreateLicense's Added-entity case): license
            // stays Modified with its correct original values from the initial load, so a
            // retry with a different label just re-mutates the same tracked instance.
            errorMessage = pgEx.ConstraintName == "IX_Licenses_Label"
                ? "This label already exists."
                : "Something went wrong while saving. Please try again.";
            successMessage = null;
            return;
        }

        errorMessage = null;
        successMessage = $"License \"{license.Label}\" updated" +
            (license.ExpiresOn is not null ? $" — expires on {license.ExpiresOn:yyyy-MM-dd}." : ".");
    }

    private sealed class EditLicenseFormModel
    {
        [Required]
        public string Label { get; set; } = "";

        public DateOnly? ExpiresOn { get; set; }
    }
}
